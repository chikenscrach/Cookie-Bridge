{
  "format": "cookie-bridge",
  "version": 1,
  "site": "https://example.com",
  "cookies": [
    {
      "domain": "example.com",
      "hostOnly": true,
      "path": "/",
      "secure": true,
      "httpOnly": true,
      "sameSite": "lax",
      "session": true,
      "name": "__Host-demo",
      "value": "EXAMPLE_ONLY_NOT_A_REAL_SESSION"
    },
    {
      "domain": ".example.com",
      "hostOnly": false,
      "path": "/",
      "secure": true,
      "httpOnly": false,
      "sameSite": "strict",
      "session": true,
      "name": "demo-theme",
      "value": "light"
    }
  ]
}
